{
  "name": "tidewater",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5189",
    "build": "vite build && node tools/check-pages-limits.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy",
