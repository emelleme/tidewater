    "test": "node test/game-logic.mjs && node test/engine-smoke.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "webgpu": "^0.6.1",
    "wrangler": "^4.152.0"
  },
  "license": "MIT",
  "private": true,
  "type": "module"
}
