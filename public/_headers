# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Pages parses this file from the root of the build output and does not serve it; Vite copies it
# there from public/. GitHub Pages ignores it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Vite fingerprints the bundle (assets/index-<hash>.js), so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell has to revalidate, so a new deployment is picked up on the next visit.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Models, audio, key art and noise textures keep their names between builds: cache them for a day.
/models/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
/clouds/*
  Cache-Control: public, max-age=86400
/textures/*
  Cache-Control: public, max-age=86400
/ui/*
  Cache-Control: public, max-age=86400
